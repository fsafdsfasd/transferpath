# Copy to .env.local for local dev. On Vercel, add the same keys in Project → Settings → Environment Variables.
# Never commit .env.local. Never prefix server secrets with NEXT_PUBLIC_.

# --- Required (app + auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# --- Production site URL (emails + OAuth redirects) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: support link in Settings → Help ---
# NEXT_PUBLIC_SUPPORT_EMAIL=you@example.com

# --- Server-only (cron emails; not required for basic deploy) ---
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# CRON_SECRET=generate_a_long_random_string
# RESEND_API_KEY=re_xxxx
# RESEND_FROM_EMAIL=TransferPath <onboarding@resend.dev>
